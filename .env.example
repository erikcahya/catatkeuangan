# Salin ke .env lalu isi kata sandi Postgres Anda.
DATABASE_URL=postgres://postgres:GANTI_KATA_SANDI@localhost:5432/catatkeuangan
PORT=3000
# production = cookie hanya lewat HTTPS
NODE_ENV=development

# Untuk docker compose (deploy)
# POSTGRES_PASSWORD=GANTI

# Database terpisah untuk npm run test:db (dikosongkan setiap tes)
TEST_DATABASE_URL=postgres://postgres:GANTI_KATA_SANDI@localhost:5432/catatkeuangan_test
